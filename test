#!/bin/bash
#
# Runs the unit tests of the build program (docker/tests) in the build container, with coverage; the coverage report
# (HTML) replaces output/test_report. Arguments are passed to unittest (e.g. ./test -v).
# See README.md (section 10).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="$ROOT/docker/compose.yaml"
SERVICE="builder"

echo "Preparing the build container (the first run builds it: about 30 minutes)"
docker compose -f "$COMPOSE_FILE" build --quiet "$SERVICE"

# stderr (unittest writes its results there) into stdout, so the output stays in order
exec docker compose -f "$COMPOSE_FILE" run --rm -T -w /work/docker "$SERVICE" sh -c 'exec python3 -m builder.self_test "$@" 2>&1' test --owner "$(id -u):$(id -g)" "$@"
